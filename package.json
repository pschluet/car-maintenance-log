{
  "name": "car-maintenance-log",
  "private": true,
  "workspaces": [
    "web",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "synth": "npm run synth -w infra",
    "deploy": "npm run deploy -w infra",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome lint .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "ci:check": "biome ci .",
    "seed:local": "tsx scripts/seed-local.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@biomejs/biome": "2.5.6",
    "tsx": "^4.22.4"
  }
}
