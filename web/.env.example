# Copied to production via CDK env vars on the Lambda; only needed here for
# local reference / to fill in docker-compose overrides.

TABLE_NAME=CarMaintenanceLog
ATTACHMENTS_BUCKET=car-maintenance-log-attachments
USER_POOL_ID=
USER_POOL_CLIENT_ID=
SITE_URL=http://localhost:3000
FROM_EMAIL=no-reply@pauldev.io
AWS_REGION=us-east-1

# Local-dev-only. Never set in the deployed Lambda environment: when set,
# every request is treated as the seeded local admin instead of verifying a
# real Cognito session. See src/lib/session.ts.
LOCAL_AUTH=false

# Local-dev-only endpoint overrides so the SDK clients talk to
# dynamodb-local / MinIO instead of real AWS. Leave unset in production.
DYNAMODB_ENDPOINT=
S3_ENDPOINT=
# Only needed if S3_ENDPOINT is set to a hostname the browser can't
# resolve (e.g. docker-compose's "minio") — presigned URLs are signed
# against this instead. See src/lib/s3.ts.
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=
